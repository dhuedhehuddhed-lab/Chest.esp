		Position = UDim2.new(0, 0, 0, -12),
		Size = UDim2.new(1, 0, 1, 24),
		BackgroundTransparency = 1,
		Text = "",
		Parent = track_,
	})

	local function setValue(v, silent)
		v = math.clamp(math.floor(v + 0.5), min, max)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valueLabel.Text = tostring(v)
		if not silent then
			callback(v)
		end
	end

	local function updateFromX(x)
		local a = math.clamp((x - track_.AbsolutePosition.X) / math.max(track_.AbsoluteSize.X, 1), 0, 1)
		setValue(min + a * (max - min))
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		content.ScrollingEnabled = false
		updateFromX(input.Position.X)

		local moveConn, endConn
		moveConn = UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement
				or i.UserInputType == Enum.UserInputType.Touch then
				updateFromX(i.Position.X)
			end
		end)
		endConn = UserInputService.InputEnded:Connect(function(i)
			if i == input or (input.UserInputType == Enum.UserInputType.MouseButton1
				and i.UserInputType == Enum.UserInputType.MouseButton1) then
				moveConn:Disconnect()
				endConn:Disconnect()
				content.ScrollingEnabled = true
			end
		end)
	end)

	setValue(default, true) -- initial visual only; feature tables already hold the default
end

----------------------------------------------------------------------
-- Shared helpers
----------------------------------------------------------------------
local function getFxFolder()
	local cam = Workspace.CurrentCamera
	local parent = cam or Workspace
	local f = parent:FindFirstChild("MT_FX")
	if not f then
		f = new("Folder", { Name = "MT_FX", Parent = parent })
	end
	return f
end

-- Characters that must never be touched: mine + every LIVING player.
-- Dead players (ragdoll corpses) and NPCs are treated like any other object.
local function buildExcluded()
	local list = {}
	if LocalPlayer.Character then
		list[#list + 1] = LocalPlayer.Character
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		local c = plr.Character
		if c and plr ~= LocalPlayer then
			local h = c:FindFirstChildOfClass("Humanoid")
			if not h or h.Health > 0 then
				list[#list + 1] = c
			end
		end
	end
	return list
end

local function isInsideAny(part, list)
	for i = 1, #list do
		if part:IsDescendantOf(list[i]) then
			return true
		end
	end
	return false
end

local function groundCast(origin, maxDist, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	return Workspace:Raycast(origin, Vector3.new(0, -maxDist, 0), params)
end

-- Expanding neon ring + dust burst (takeoff / landing)
local function spawnShockwave(pos, maxRadius, color, duration)
	local ring = new("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Material = Enum.Material.Neon,
		Color = color,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.25, 2, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Parent = getFxFolder(),
	})

	local dust = new("ParticleEmitter", {
		Rate = 0,
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(85, 85),
		Drag = 3,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 4) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.fromRGB(215, 215, 215)),
		Parent = ring,
	})
	dust:Emit(28)

	task.spawn(function()
		local t0 = os.clock()
		while ring.Parent do
			local a = (os.clock() - t0) / duration
			if a >= 1 then
				break
			end
			local e = 1 - (1 - a) ^ 3
			local d = 2 + maxRadius * 2 * e
			ring.Size = Vector3.new(0.25, d, d)
			ring.Transparency = 0.2 + 0.8 * a
			RunService.RenderStepped:Wait()
		end
		ring:Destroy()
	end)
end

