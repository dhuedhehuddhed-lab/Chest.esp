	end
	task.defer(function()
		local vs = gui.AbsoluteSize
		local p = root.AbsolutePosition
		local cx = math.clamp(p.X, 0, math.max(vs.X - 120, 0))
		local cy = math.clamp(p.Y, 0, math.max(vs.Y - 60, 0))
		if cx ~= p.X or cy ~= p.Y then
			local pos = root.Position
			root.Position = UDim2.new(pos.X.Scale, pos.X.Offset + (cx - p.X), pos.Y.Scale, pos.Y.Offset + (cy - p.Y))
		end
	end)
end

