-- === ЛОГИКА ESP ===
local activeHighlights = {}

local function clearAllHighlights()
    for _, h in pairs(activeHighlights) do
        if h and h.Parent then h:Destroy() end
    end
    activeHighlights = {}
end

local function createHighlight(obj)
    if not obj or not obj.Parent then return end
    if activeHighlights[obj] and activeHighlights[obj].Parent then return end
    local h = Instance.new("Highlight")
    h.Adornee = obj
    h.FillColor = ESP_CONFIG.FillColor
    h.OutlineColor = ESP_CONFIG.OutlineColor
    h.FillTransparency = ESP_CONFIG.FillTransparency
    h.OutlineTransparency = ESP_CONFIG.OutlineTransparency
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = obj
    activeHighlights[obj] = h
end

local function scanForChests()
    if not ESP_CONFIG.Enabled then return end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            for _, namePattern in ipairs(ESP_CONFIG.ChestNames) do
                if string.find(string.lower(obj.Name), string.lower(namePattern)) then
                    createHighlight(obj)
                    break
                end
            end
        end
    end
end

task.spawn(function()
    while task.wait(1) do
        if ESP_CONFIG.Enabled then scanForChests() end
    end
end)

-- === ЛОГИКА FLY ===
local flyConn, flyBV, flyBG

local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
end

local function startFly()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    hum.PlatformStand = true

    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyBG.CFrame = hrp.CFrame
    flyBG.P = 10000
    flyBG.D = 500
    flyBG.Parent = hrp

    flyConn = RunService.RenderStepped:Connect(function()
        if not FLY_CONFIG.Enabled then return end
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, FLY_CONFIG.LiftSpeed / FLY_CONFIG.Speed, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, FLY_CONFIG.LiftSpeed / FLY_CONFIG.Speed, 0) end

        if dir.Magnitude > 0 then
            flyBV.Velocity = dir.Unit * FLY_CONFIG.Speed
        else
            flyBV.Velocity = Vector3.zero
        end
        flyBG.CFrame = cam.CFrame
    end)
end

-- === ЛОГИКА MAGNET + FORMATION ===
local capturedParts = {}   -- [part] = {bp=, bg=, idx=}
local magnetConn

local function isPartOfAnyCharacter(part)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character and part:IsDescendantOf(plr.Character) then
            return true
        end
    end
    return false
end

local function releasePart(part)
    local data = capturedParts[part]
    if not data then return end
    if data.bp then data.bp:Destroy() end
    if data.bg then data.bg:Destroy() end
    capturedParts[part] = nil
end

local function releaseAllParts()
    for part, _ in pairs(capturedParts) do
        releasePart(part)
    end
    capturedParts = {}
end

local function capturePart(part, idx)
    if capturedParts[part] then return end
    part.CanCollide = false

    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.P = 50000
    bp.D = 800
    bp.Position = part.Position
    bp.Parent = part

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 10000
    bg.D = 500
    bg.CFrame = part.CFrame
    bg.Parent = part

    capturedParts[part] = {bp = bp, bg = bg, idx = idx}
end

local function findUnanchoredParts()
    local list = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored then
            if not isPartOfAnyCharacter(obj) then
                table.insert(list, obj)
            end
            if #list >= MAGNET_CONFIG.Count then break end
        end
    end
    return list
end

-- Вычисление точки формации по индексу
local function getFormationOffset(idx, total, shape, R, timeOffset)
    total = math.max(total, 1)
    local ratio = (idx - 1) / total
    local angle = ratio * math.pi * 2

    if shape == "Circle" then
        return Vector3.new(math.cos(angle) * R, 0, math.sin(angle) * R)

    elseif shape == "Sphere" then
        -- равномерное распределение (спираль Фибоначчи)
        local i = idx
        local phi = math.acos(1 - 2 * (i + 0.5) / total)
        local theta = math.pi * (1 + 5 ^ 0.5) * (i + 0.5)
        return Vector3.new(
            math.sin(phi) * math.cos(theta) * R,
            math.cos(phi) * R,
            math.sin(phi) * math.sin(theta) * R
        )

    elseif shape == "Cube" then
        -- распределяем по 6 граням куба
        local perFace = math.max(math.ceil(total / 6), 1)
        local face = math.floor((idx - 1) / perFace) % 6
        local localIdx = (idx - 1) % perFace
        local u = (localIdx / math.max(perFace - 1, 1)) - 0.5
        local v = ((idx * 7) % 100) / 100 - 0.5
        local half = R

        if face == 0 then return Vector3.new( half, u * R * 2, v * R * 2) end
        if face == 1 then return Vector3.new(-half, u * R * 2, v * R * 2) end
        if face == 2 then return Vector3.new(u * R * 2,  half, v * R * 2) end
        if face == 3 then return Vector3.new(u * R * 2, -half, v * R * 2) end
        if face == 4 then return Vector3.new(u * R * 2, v * R * 2,  half) end
        return Vector3.new(u * R * 2, v * R * 2, -half)

    elseif shape == "Helix" then
        -- спираль по вертикали
        local height = R * 3
        local y = -height / 2 + ratio * height
        local a = ratio * math.pi * 6
        return Vector3.new(math.cos(a) * R * 0.7, y, math.sin(a) * R * 0.7)
    end

    return Vector3.zero
end

local function startMagnet()
    magnetConn = RunService.RenderStepped:Connect(function()
        if not MAGNET_CONFIG.Enabled then return end
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- чистим мёртвые ссылки
        for part, _ in pairs(capturedParts) do
            if not part or not part.Parent then
                releasePart(part)
            end
        end

        -- добираем новые, если не хватает
        local currentCount = 0
        for _ in pairs(capturedParts) do currentCount = currentCount + 1 end

        if currentCount < MAGNET_CONFIG.Count then
            local candidates = findUnanchoredParts()
            local added = 0
            for _, part in ipairs(candidates) do
                if not capturedParts[part] then
                    capturePart(part, currentCount + added + 1)
                    added = added + 1
                    if currentCount + added >= MAGNET_CONFIG.Count then break end
                end
            end
        end

        -- обновляем позиции
        local total = 0
        for _ in pairs(capturedParts) do total = total + 1 end

        local t = tick()
        for part, data in pairs(capturedParts) do
            if data.bp and data.bp.Parent then
                local offset = getFormationOffset(data.idx, total, MAGNET_CONFIG.Shape, MAGNET_CONFIG.Radius, t)
                data.bp.Position = hrp.Position + offset
            end

            if data.bg and data.bg.Parent then
                if MAGNET_CONFIG.Spin then
                    local angle = t * MAGNET_CONFIG.SpinSpeed
                    data.bg.CFrame = CFrame.new(part.Position) * CFrame.Angles(angle, angle * 0.7, angle * 0.4)
                else
                    data.bg.CFrame = CFrame.new(part.Position) * part.CFrame.Rotation
                end
            end
        end
    end)
end

local function stopMagnet()
    if magnetConn then magnetConn:Disconnect(); magnetConn = nil end
    releaseAllParts()
end

