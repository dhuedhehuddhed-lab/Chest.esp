		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track_,
	})
	corner(knob, 7)

	local hit = new("TextButton", { -- enlarged touch/click target
		Position = UDim2.new(0, 0, 0, -12),
		Size = UDim2.new(1, 0, 1, 24),
		BackgroundTransparency = 1,
		Text = "",
		Parent = track_,
	})

	local function setValue(v, silent)
		v = math.clamp(math.floor(v + 0.5), min, max)
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valueLabel.Text = tostring(v)
		if not silent then
			callback(v)
		end
	end

	local function updateFromX(x)
		local a = math.clamp((x - track_.AbsolutePosition.X) / math.max(track_.AbsoluteSize.X, 1), 0, 1)
		setValue(min + a * (max - min))
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		content.ScrollingEnabled = false
		updateFromX(input.Position.X)

		local moveConn, endConn
		moveConn = UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement
				or i.UserInputType == Enum.UserInputType.Touch then
				updateFromX(i.Position.X)
			end
		end)
		endConn = UserInputService.InputEnded:Connect(function(i)
			if i == input or (input.UserInputType == Enum.UserInputType.MouseButton1
				and i.UserInputType == Enum.UserInputType.MouseButton1) then
				moveConn:Disconnect()
				endConn:Disconnect()
				content.ScrollingEnabled = true
			end
		end)
	end)

	setValue(default, true) -- initial visual only; feature tables already hold the default
end

----------------------------------------------------------------------
-- FLY MODE
----------------------------------------------------------------------
local Fly = {
	enabled = false,
	speed = CONFIG.Fly.Speed,
	vspeed = CONFIG.Fly.VerticalSpeed,
}
local flyBV, flyBG, flyHum, flyConn

local function stopFly()
	if flyConn then
		flyConn:Disconnect()
		flyConn = nil
	end
	if flyBV then
		flyBV:Destroy()
		flyBV = nil
	end
	if flyBG then
		flyBG:Destroy()
		flyBG = nil
	end
	if flyHum then
		pcall(function()
			flyHum.PlatformStand = false
		end)
		flyHum = nil
	end
end

local function startFly()
	stopFly()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		return
	end

	flyHum = hum
	hum.PlatformStand = true

	flyBV = Instance.new("BodyVelocity")
	flyBV.Name = "MT_FlyBV"
	flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	flyBV.Velocity = Vector3.zero
	flyBV.Parent = hrp

	flyBG = Instance.new("BodyGyro")
	flyBG.Name = "MT_FlyBG"
	flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	flyBG.P = 2e4
	flyBG.D = 500
	flyBG.CFrame = hrp.CFrame
	flyBG.Parent = hrp

	flyConn = RunService.RenderStepped:Connect(function()
		if not hrp.Parent or not flyBV or not flyBG then
			return
		end
		local cf = Workspace.CurrentCamera.CFrame
		local dir = Vector3.zero
		local vert = 0

		if not UserInputService:GetFocusedTextBox() then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert += Fly.vspeed end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vert -= Fly.vspeed end
		end

		local horizontal = Vector3.zero
		if dir.Magnitude > 0 then
			horizontal = dir.Unit * Fly.speed
		end

		flyBV.Velocity = horizontal + Vector3.new(0, vert, 0)
		flyBG.CFrame = cf
	end)
end

local function setFly(on)
	Fly.enabled = on
	if on then
		startFly()
	else
		stopFly()
	end
end

-- Re-apply flight after respawn
track(LocalPlayer.CharacterAdded:Connect(function(char)
	if Fly.enabled then
		char:WaitForChild("HumanoidRootPart", 10)
		char:WaitForChild("Humanoid", 10)
		if Fly.enabled then
			startFly()
		end
	end
end))

----------------------------------------------------------------------
-- MAGNET + FORMATION
----------------------------------------------------------------------
local Magnet = {
	enabled = false,
	count = CONFIG.Magnet.PartCount,
	radius = CONFIG.Magnet.Radius,
	shapes = { "Circle", "Sphere", "Cube", "Helix" },
	shape = 1,
	spin = false,
	spinSpeed = CONFIG.Magnet.SpinSpeed,
	dirty = false,
}
local captured = {}      -- array of { part, bp, bg, canCollide }
local capturedSet = {}   -- [part] = entry
local magnetConn
local spinAngle = 0
local lastScan = 0

local function norm(k, side)
	if side > 1 then
		return (k / (side - 1)) * 2 - 1
	end
	return 0
end

local function formationOffset(shape, i, n, r, rot)
	local v
	if shape == "Circle" then
		local a = (i / n) * math.pi * 2
		v = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)

	elseif shape == "Sphere" then -- Fibonacci sphere
		local y = 1 - 2 * (i - 0.5) / n
		local rad = math.sqrt(math.max(0, 1 - y * y))
		local theta = i * 2.399963229728653
		v = Vector3.new(math.cos(theta) * rad, y, math.sin(theta) * rad) * r

	elseif shape == "Cube" then -- points spread over the 6 faces
		local idx = i - 1
		local face = idx % 6
		local j = math.floor(idx / 6)
		local side = math.max(1, math.ceil(math.sqrt(math.ceil(n / 6))))
		local u = norm(j % side, side)
		local w = norm(math.floor(j / side), side)
		if face == 0 then v = Vector3.new(1, u, w)
		elseif face == 1 then v = Vector3.new(-1, u, w)
		elseif face == 2 then v = Vector3.new(u, 1, w)
		elseif face == 3 then v = Vector3.new(u, -1, w)
		elseif face == 4 then v = Vector3.new(u, w, 1)
		else v = Vector3.new(u, w, -1) end
		v = v * r

	else -- Helix
		local f = n > 1 and (i - 1) / (n - 1) or 0.5
		local a = f * math.pi * 2 * 3
		v = Vector3.new(math.cos(a) * r, (f * 2 - 1) * r, math.sin(a) * r)
	end

	return CFrame.Angles(0, rot, 0) * v -- slow orbit around the player
end

local function release(entry)
	capturedSet[entry.part] = nil
	if entry.bp then entry.bp:Destroy() end
	if entry.bg then entry.bg:Destroy() end
	if entry.part and entry.part.Parent then
		entry.part.CanCollide = entry.canCollide
	end
end

local function capture(part)
	local bp = Instance.new("BodyPosition")
	bp.Name = "MT_BP"
	bp.MaxForce = Vector3.new(1e8, 1e8, 1e8)
	bp.P = 3e4
	bp.D = 1e3
	bp.Position = part.Position
	bp.Parent = part

	local bg = Instance.new("BodyGyro")
	bg.Name = "MT_BG"
	bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
	bg.P = 2e4
	bg.D = 500
	bg.CFrame = part.CFrame
	bg.Parent = part

	local entry = { part = part, bp = bp, bg = bg, canCollide = part.CanCollide }
	part.CanCollide = false -- avoids parts shoving the player / each other
	capturedSet[part] = entry
	return entry
end

local function isInsideAnyCharacter(part, chars)
	for i = 1, #chars do
		if part:IsDescendantOf(chars[i]) then
			return true
		end
	end
	return false
end

local function refreshCaptures()
	-- 1) prune dead entries
	local alive = {}
	for _, e in ipairs(captured) do
		local p = e.part
		if p.Parent and not p.Anchored and e.bp.Parent == p and e.bg.Parent == p then
			alive[#alive + 1] = e
		else
			release(e)
		end
	end
	captured = alive

	-- 2) trim extras
	while #captured > Magnet.count do
		release(table.remove(captured))
	end

	-- 3) fill up with the nearest free parts
	if #captured < Magnet.count then
		local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end

		local chars = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then
				chars[#chars + 1] = plr.Character
			end
		end

		local found = {}
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not obj.Anchored and not capturedSet[obj]
				and not isInsideAnyCharacter(obj, chars) then
				local rootPart = obj.AssemblyRootPart
				if not (rootPart and rootPart.Anchored) then
					found[#found + 1] = { part = obj, dist = (obj.Position - hrp.Position).Magnitude }
				end
			end
		end

		table.sort(found, function(a, b)
			return a.dist < b.dist
		end)

		for i = 1, math.min(Magnet.count - #captured, #found) do
			captured[#captured + 1] = capture(found[i].part)
		end
	end
end

local function magnetStep(dt)
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local now = os.clock()
	if (Magnet.dirty and now - lastScan > 0.25) or (#captured < Magnet.count and now - lastScan > 2) then
		Magnet.dirty = false
		lastScan = now
		refreshCaptures()
	end

	spinAngle += dt * Magnet.spinSpeed

	local n = #captured
	local center = hrp.Position
	local shape = Magnet.shapes[Magnet.shape]
	local rot = now * 0.5
	local needsPrune = false

	for i, e in ipairs(captured) do
		if e.part.Parent and e.bp.Parent and e.bg.Parent then
			e.bp.Position = center + formationOffset(shape, i, n, Magnet.radius, rot)
			if Magnet.spin then
				e.bg.CFrame = CFrame.Angles(0, spinAngle + i * 0.5, 0)
			else
				e.bg.CFrame = CFrame.new()
			end
		else
			needsPrune = true
		end
	end

	if needsPrune then
		Magnet.dirty = true
	end
end

local function releaseAll()
	for _, e in ipairs(captured) do
		release(e)
	end
	captured = {}
	capturedSet = {}
end

local function setMagnet(on)
	Magnet.enabled = on
	if magnetConn then
		magnetConn:Disconnect()
		magnetConn = nil
	end
	if on then
		pcall(function()
			LocalPlayer.MaximumSimulationRadius = math.huge
		end)
		pcall(function()
			sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
		end)
		Magnet.dirty = true
		magnetConn = RunService.Heartbeat:Connect(magnetStep)
	else
		releaseAll() -- BodyPosition/BodyGyro destroyed, parts fall back
	end
end

----------------------------------------------------------------------
-- PLAYER ESP
----------------------------------------------------------------------
local ESP = {
	enabled = false,
	showNames = CONFIG.ESP.ShowNames,
	fillIndex = presetIndex(CONFIG.ESP.FillColor),
	outlineIndex = presetIndex(CONFIG.ESP.OutlineColor),
	fillTransparency = CONFIG.ESP.FillTransparency,
	outlineTransparency = CONFIG.ESP.OutlineTransparency,
	objects = {},   -- [player] = { highlight, billboard, died }
	hooks = {},     -- [player] = { connections }
}

local function clearESP(plr)
	local e = ESP.objects[plr]
	if not e then
		return
	end
	ESP.objects[plr] = nil
	if e.died then e.died:Disconnect() end
	if e.highlight then e.highlight:Destroy() end
	if e.billboard then e.billboard:Destroy() end
end

local function applyESP(plr)
	clearESP(plr)
	if not ESP.enabled or plr == LocalPlayer then
		return
	end
	local char = plr.Character
	if not char then
		return
	end

	local entry = {}
	ESP.objects[plr] = entry

	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 10)
		local head = char:WaitForChild("Head", 10)
		-- bail if state changed while waiting (toggled off, respawned, left, ...)
		if ESP.objects[plr] ~= entry or plr.Character ~= char or not hum or hum.Health <= 0 then
			return
		end

		local h = Instance.new("Highlight")
		h.Name = "MT_ESP"
		h.Adornee = char
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.FillColor = ColorPresets[ESP.fillIndex][2]
		h.OutlineColor = ColorPresets[ESP.outlineIndex][2]
		h.FillTransparency = ESP.fillTransparency
		h.OutlineTransparency = ESP.outlineTransparency
		h.Parent = espFolder
		entry.highlight = h

		if head then
			local bb = Instance.new("BillboardGui")
			bb.Name = "MT_Name"
			bb.Adornee = head
			bb.AlwaysOnTop = true
			bb.Size = UDim2.fromOffset(200, 30)
			bb.StudsOffset = Vector3.new(0, 2.5, 0)
			bb.Enabled = ESP.showNames
			bb.Parent = espFolder

			new("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Text = plr.DisplayName,
				TextColor3 = Color3.new(1, 1, 1),
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0.4,
				TextSize = 14,
				Parent = bb,
			})
			entry.billboard = bb
		end

		entry.died = hum.Died:Connect(function()
			if ESP.objects[plr] == entry then
				clearESP(plr)
			end
		end)
	end)
end

local function updateESPStyle()
	for _, e in pairs(ESP.objects) do
		if e.highlight then
			e.highlight.FillColor = ColorPresets[ESP.fillIndex][2]
			e.highlight.OutlineColor = ColorPresets[ESP.outlineIndex][2]
			e.highlight.FillTransparency = ESP.fillTransparency
			e.highlight.OutlineTransparency = ESP.outlineTransparency
		end
		if e.billboard then
			e.billboard.Enabled = ESP.showNames
		end
	end
end

local function hookPlayer(plr)
	if plr == LocalPlayer or ESP.hooks[plr] then
		return
	end
	ESP.hooks[plr] = {
		plr.CharacterAdded:Connect(function()
			applyESP(plr)
		end),
		plr.CharacterRemoving:Connect(function()
			clearESP(plr)
		end),
	}
	if plr.Character then
		applyESP(plr)
	end
end

local function unhookPlayer(plr)
	clearESP(plr)
	local hooks = ESP.hooks[plr]
	if hooks then
		for _, c in ipairs(hooks) do
			c:Disconnect()
		end
		ESP.hooks[plr] = nil
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
	hookPlayer(plr)
end
track(Players.PlayerAdded:Connect(hookPlayer))
track(Players.PlayerRemoving:Connect(unhookPlayer))

local function setESP(on)
	ESP.enabled = on
	if on then
		for _, plr in ipairs(Players:GetPlayers()) do
			applyESP(plr)
		end
	else
		for plr in pairs(ESP.objects) do
			clearESP(plr)
		end
	end
end

----------------------------------------------------------------------
-- Cleanup / close
----------------------------------------------------------------------
local function cleanup()
	Fly.enabled = false
	stopFly()
	setMagnet(false)

	ESP.enabled = false
	for plr in pairs(ESP.objects) do
		clearESP(plr)
	end
	for plr in pairs(ESP.hooks) do
		unhookPlayer(plr)
	end

	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	connections = {}

	if espFolder then espFolder:Destroy() end
	if gui then gui:Destroy() end
	env.__MultiToolCleanup = nil
end

env.__MultiToolCleanup = cleanup
closeBtn.MouseButton1Click:Connect(cleanup)

