	state = "off", -- off | active | landing
	speed = CONFIG.Fly.Speed,
	vspeed = CONFIG.Fly.VerticalSpeed,
	effects = CONFIG.Fly.Effects,
}

local fly = {} -- runtime state, reset by stopFly()
local ARM_JOINTS = { { "RightShoulder", 1 }, { "LeftShoulder", -1 } } -- R15 arms go overhead while diving forward
local LINE_COUNT = 26

local function stopTracks(hum)
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
			tr:Stop(0.15)
		end
	end
end

local function stopFly()
	if fly.conn then
		fly.conn:Disconnect()
	end
	if fly.bv then fly.bv:Destroy() end
	if fly.bg then fly.bg:Destroy() end
	if fly.emitter then fly.emitter:Destroy() end
	if fly.linesFolder then fly.linesFolder:Destroy() end

	for _, t in ipairs(fly.trails or {}) do
		t.trail:Destroy()
		t.a0:Destroy()
		t.a1:Destroy()
	end
	for _, m in ipairs(fly.motors or {}) do
		pcall(function()
			m.motor.C0 = m.c0
		end)
	end
	if fly.animate then
		pcall(function()
			fly.animate.Disabled = false
		end)
	end
	if fly.hum then
		pcall(function()
			fly.hum.PlatformStand = false
			fly.hum.AutoRotate = true
		end)
	end
	local cam = Workspace.CurrentCamera
	if cam and fly.baseFOV then
		cam.FieldOfView = fly.baseFOV
	end

	fly = {}
	Fly.state = "off"
end

local function ensureMovers(hrp)
	if not fly.bv or fly.bv.Parent ~= hrp then
		if fly.bv then fly.bv:Destroy() end
		fly.bv = new("BodyVelocity", {
			Name = "MT_FlyBV",
			MaxForce = Vector3.new(1e9, 1e9, 1e9),
			P = 1e4,
			Velocity = Vector3.zero,
			Parent = hrp,
		})
	end
	if not fly.bg or fly.bg.Parent ~= hrp then
		if fly.bg then fly.bg:Destroy() end
		fly.bg = new("BodyGyro", {
			Name = "MT_FlyBG",
			MaxTorque = Vector3.new(1e9, 1e9, 1e9),
			P = 2e4,
			D = 500,
			CFrame = hrp.CFrame,
			Parent = hrp,
		})
	end
end

local function setupTrails(char, hrp)
	local list = {}
	local function addTrail(part, p0, p1, lifetime)
		local a0 = new("Attachment", { Name = "MT_T0", Position = p0, Parent = part })
		local a1 = new("Attachment", { Name = "MT_T1", Position = p1, Parent = part })
		local tr = new("Trail", {
			Name = "MT_Trail",
			Attachment0 = a0,
			Attachment1 = a1,
			Lifetime = lifetime,
			MinLength = 0.05,
			FaceCamera = true,
			LightEmission = 1,
			Enabled = false,
			Color = ColorSequence.new(Color3.new(1, 1, 1), Theme.Accent),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }),
			WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
			Parent = part,
		})
		list[#list + 1] = { trail = tr, a0 = a0, a1 = a1 }
	end

	local limbs = { "RightHand", "LeftHand", "RightFoot", "LeftFoot", "Right Arm", "Left Arm", "Right Leg", "Left Leg" }
	for _, name in ipairs(limbs) do
		local p = char:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			addTrail(p, Vector3.new(0, -0.45, 0), Vector3.new(0, 0.45, 0), 0.45)
		end
	end
	addTrail(hrp, Vector3.new(-1.4, 0.4, 0), Vector3.new(1.4, 0.4, 0), 0.7) -- wide wake behind the body
	return list
end

local function setupLines()
	local folder = new("Folder", { Name = "MT_SpeedLines", Parent = getFxFolder() })
	local lines = {}
	for i = 1, LINE_COUNT do
		local ang = math.random() * math.pi * 2
		local rad = 5 + math.random() * 14
		lines[i] = {
			part = new("Part", {
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(210, 225, 255),
				Transparency = 1,
				Size = Vector3.new(0.07, 0.07, 6),
				Parent = folder,
			}),
			x = math.cos(ang) * rad,
			y = math.sin(ang) * rad,
			z = math.random() * 100 - 50,
			spd = 0.8 + math.random() * 0.6,
		}
	end
	return folder, lines
end

local function updateLines(dt, center, dirUnit, speed, f)
	local up = math.abs(dirUnit.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	local frame = CFrame.lookAt(center, center + dirUnit, up)
	for _, l in ipairs(fly.lines) do
		l.z += dt * speed * 1.4 * l.spd -- local +Z is "behind" the flight direction
		if l.z > 50 then
			l.z = -50
		end
		local fade = 1 - math.abs(l.z) / 50
		l.part.Size = Vector3.new(0.07, 0.07, 3 + speed * 0.05 * l.spd)
		l.part.CFrame = frame * CFrame.new(l.x, l.y, l.z)
		l.part.Transparency = 1 - f * 0.7 * fade
	end
end

local function flyStep(dt)
	local hrp, hum, char = fly.hrp, fly.hum, fly.char
	if not hrp or not hum or not hrp:IsDescendantOf(Workspace) or hum.Health <= 0 then
		stopFly() -- Fly.enabled stays true, so respawn restarts flight
		return
	end

	local cam = Workspace.CurrentCamera
	local now = os.clock()
	local landing = Fly.state == "landing"

	-- Watchdog: re-create movers / re-assert state if a game script removes them
	ensureMovers(hrp)
	if not hum.PlatformStand then hum.PlatformStand = true end
	if hum.AutoRotate then hum.AutoRotate = false end
	if now - (fly.lastTrack or 0) > 0.4 then
		fly.lastTrack = now
		stopTracks(hum)
	end

	-- Input (relative to the camera)
	local cf = cam.CFrame
	local look, right = cf.LookVector, cf.RightVector
	local dir, vert = Vector3.zero, 0
	if not landing and not UserInputService:GetFocusedTextBox() then
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += look end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= look end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += right end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= right end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert += Fly.vspeed end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vert -= Fly.vspeed end
	end

	local target = Vector3.zero
	if dir.Magnitude > 0 then
		target = dir.Unit * Fly.speed
	end
	target += Vector3.new(0, vert, 0)

	-- Takeoff boost (eased rocket launch)
	if fly.takeoff then
		local k = (now - fly.t0) / 0.9
		if k < 1 then
			target += Vector3.new(0, 55 * (1 - k) ^ 2, 0)
		else
			fly.takeoff = false
		end
	end

	-- Idle hover bob
	if dir.Magnitude == 0 and vert == 0 and not landing then
		target += Vector3.new(0, math.sin(now * 2) * 1.5, 0)
	end

	-- Landing: soft descent that slows down near the ground
	local hit
	if landing then
		local ignore = { char, getFxFolder() }
		hit = groundCast(hrp.Position, 300, ignore)
		local clearance = hum.RigType == Enum.HumanoidRigType.R6 and 3 or (hum.HipHeight + hrp.Size.Y / 2)
		local h = hit and (hrp.Position.Y - hit.Position.Y - clearance) or 1e9
		target = Vector3.new(0, -math.clamp(h * 2.2, 6, 70), 0)
		if h < 1 or now - fly.landStart > 4 then
			local effects, pos = Fly.effects, hit and hit.Position
			local impact = math.abs(fly.vel.Y)
			stopFly()
			if effects and pos then
				spawnShockwave(pos, 9 + math.min(impact, 60) * 0.15, Color3.fromRGB(200, 215, 255), 0.7)
			end
			return
		end
	end

	-- Smooth acceleration
	fly.vel = fly.vel:Lerp(target, 1 - math.exp(-dt * (landing and 5 or 7)))
	fly.bv.Velocity = fly.vel

	-- Orientation metrics
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 1e-3 then
		fly.flat = flat.Unit
	end
	local flatLook = fly.flat or Vector3.new(0, 0, -1)
	local yaw = math.atan2(-flatLook.X, -flatLook.Z)
	local dyaw = (yaw - fly.lastYaw + math.pi) % (math.pi * 2) - math.pi
	fly.lastYaw = yaw
	local yawRate = dt > 0 and dyaw / dt or 0

	local v = fly.vel
	local speed = v.Magnitude
	local s = math.clamp(speed / (Fly.speed * 0.85), 0, 1)
	local fwd = v:Dot(flatLook)
	local strafe = v:Dot(Vector3.new(right.X, 0, right.Z))
	local gate = math.clamp(s * 1.6, 0, 1)

	-- Lean: body axis follows the velocity direction (horizontal = Superman pose, vertical = upright)
	local leanTarget = 0
	if speed > 3 and not landing then
		leanTarget = math.clamp(math.atan2(fwd, v.Y), math.rad(-25), math.rad(105)) * gate
	end
	-- Bank: into turns (camera yaw rate) and strafing
	local rollTarget = (math.clamp(yawRate * 0.18, -1, 1) * math.rad(40)
		- math.clamp(strafe / Fly.speed, -1, 1) * math.rad(25)) * gate

	local k = 1 - math.exp(-dt * 7)
	fly.lean += (leanTarget - fly.lean) * k
	fly.roll += (rollTarget - fly.roll) * k
	fly.poseW += (math.clamp(fly.lean / math.rad(80), 0, 1) - fly.poseW) * (1 - math.exp(-dt * 5))

	fly.bg.CFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, fly.roll) * CFrame.Angles(-fly.lean, 0, 0)

	-- Arms stretch overhead as the body levels out
	for _, m in ipairs(fly.motors) do
		m.motor.C0 = m.c0 * CFrame.Angles(0, 0, m.sign * math.rad(165) * fly.poseW)
	end

	-- Visual effects
	local f = math.clamp((speed - Fly.speed * 0.35) / (Fly.speed * 0.5), 0, 1)
	local fxOn = Fly.effects

	fly.fov += ((fxOn and 20 * s or 0) - fly.fov) * k
	cam.FieldOfView = fly.baseFOV + fly.fov

	local trailsOn = fxOn and s > 0.3
	for _, t in ipairs(fly.trails) do
		t.trail.Enabled = trailsOn
	end
	fly.emitter.Rate = fxOn and f * 60 or 0

	if fxOn and f > 0.01 then
		fly.linesVisible = true
		updateLines(dt, hrp.Position, speed > 1 and v.Unit or look, speed, f)
	elseif fly.linesVisible then
		fly.linesVisible = false
		for _, l in ipairs(fly.lines) do
			l.part.Transparency = 1
		end
	end
end

local function startFly(takeoff)
	stopFly()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return
	end
	local cam = Workspace.CurrentCamera

	fly.char, fly.hrp, fly.hum = char, hrp, hum
	fly.t0 = os.clock()
	fly.takeoff = takeoff
	fly.vel = hrp.AssemblyLinearVelocity
	fly.lean, fly.roll, fly.poseW, fly.fov = 0, 0, 0, 0
	fly.baseFOV = cam.FieldOfView
	local look = cam.CFrame.LookVector
	fly.lastYaw = math.atan2(-look.X, -look.Z)

	hum.PlatformStand = true
	hum.AutoRotate = false
	fly.animate = char:FindFirstChild("Animate")
	if fly.animate then
		pcall(function()
			fly.animate.Disabled = true
		end)
	end
	stopTracks(hum)

	fly.motors = {}
	for _, j in ipairs(ARM_JOINTS) do
		local m = char:FindFirstChild(j[1], true)
		if m and m:IsA("Motor6D") then
			fly.motors[#fly.motors + 1] = { motor = m, c0 = m.C0, sign = j[2] }
		end
	end

	ensureMovers(hrp)
	fly.trails = setupTrails(char, hrp)
	fly.linesFolder, fly.lines = setupLines()
	fly.emitter = new("ParticleEmitter", {
		Rate = 0,
		Lifetime = NumberRange.new(0.35, 0.6),
		Speed = NumberRange.new(0, 2),
		LockedToPart = false,
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.new(1, 1, 1), Theme.Accent),
		Parent = hrp,
	})

	if takeoff and Fly.effects then
		local hit = groundCast(hrp.Position, 12, { char, getFxFolder() })
		if hit then
			spawnShockwave(hit.Position, 14, Color3.fromRGB(200, 215, 255), 0.8)
		end
	end

	Fly.state = "active"
	fly.conn = RunService.RenderStepped:Connect(flyStep)
end

local function setFly(on)
	if on then
		Fly.enabled = true
		if Fly.state == "landing" then
			Fly.state = "active" -- cancel the landing and keep flying
		elseif Fly.state == "off" then
			startFly(true)
		end
	else
		Fly.enabled = false
		if Fly.state == "active" then
			Fly.state = "landing"
			fly.landStart = os.clock()
		else
			stopFly()
		end
	end
end

-- Re-apply flight after respawn
track(LocalPlayer.CharacterAdded:Connect(function(char)
	if Fly.enabled then
		char:WaitForChild("HumanoidRootPart", 10)
		char:WaitForChild("Humanoid", 10)
		if Fly.enabled then
			startFly(false)
		end
	end
end))

----------------------------------------------------------------------
-- MAGNET + FORMATION (works on whole assemblies, so ragdolls/models move as one)
----------------------------------------------------------------------
local Magnet = {
	enabled = false,
	count = CONFIG.Magnet.PartCount,
	radius = CONFIG.Magnet.Radius,
	shapes = { "Circle", "Sphere", "Cube", "Helix" },
	shape = 1,
	spin = false,
	spinSpeed = CONFIG.Magnet.SpinSpeed,
	dirty = false,
}
local captured = {}    -- array of { root, bp, bg, parts = { {part, cc} } }
local capturedSet = {} -- [rootPart] = entry
local magnetConn
local spinAngle, lastScan, lastSim = 0, 0, 0

local function claimSimulation()
	pcall(function()
		LocalPlayer.MaximumSimulationRadius = math.huge
	end)
	pcall(function()
		sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
	end)
end

local function norm(k, side)
	if side > 1 then
		return (k / (side - 1)) * 2 - 1
	end
	return 0
end

local function formationOffset(shape, i, n, r, rot)
	local v
	if shape == "Circle" then
		local a = (i / n) * math.pi * 2
		v = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)

	elseif shape == "Sphere" then -- Fibonacci sphere
		local y = 1 - 2 * (i - 0.5) / n
		local rad = math.sqrt(math.max(0, 1 - y * y))
		local theta = i * 2.399963229728653
		v = Vector3.new(math.cos(theta) * rad, y, math.sin(theta) * rad) * r

	elseif shape == "Cube" then -- points spread over the 6 faces
		local idx = i - 1
		local face = idx % 6
		local j = math.floor(idx / 6)
		local side = math.max(1, math.ceil(math.sqrt(math.ceil(n / 6))))
		local u = norm(j % side, side)
		local w = norm(math.floor(j / side), side)
		if face == 0 then v = Vector3.new(1, u, w)
		elseif face == 1 then v = Vector3.new(-1, u, w)
		elseif face == 2 then v = Vector3.new(u, 1, w)
		elseif face == 3 then v = Vector3.new(u, -1, w)
		elseif face == 4 then v = Vector3.new(u, w, 1)
		else v = Vector3.new(u, w, -1) end
		v = v * r

	else -- Helix
		local f = n > 1 and (i - 1) / (n - 1) or 0.5
		local a = f * math.pi * 2 * 3
		v = Vector3.new(math.cos(a) * r, (f * 2 - 1) * r, math.sin(a) * r)
	end

	return CFrame.Angles(0, rot, 0) * v -- slow orbit around the player
end

local function release(entry)
	capturedSet[entry.root] = nil
	if entry.bp then entry.bp:Destroy() end
	if entry.bg then entry.bg:Destroy() end
	for _, p in ipairs(entry.parts) do
		if p.part.Parent then
			p.part.CanCollide = p.cc
		end
	end
end

local function capture(root)
	local mass = math.max(root.AssemblyMass, 0.05)

	local bp = new("BodyPosition", {
		Name = "MT_BP",
		MaxForce = Vector3.one * mass * 2000, -- ~10g worth of force, scales with the assembly
		P = mass * 400,
		D = mass * 45,
		Position = root.Position,
		Parent = root,
	})
	local bg = new("BodyGyro", {
		Name = "MT_BG",
		MaxTorque = Vector3.one * math.max(4e5, mass * 4e4),
		P = 3e3,
		D = 3e2,
		CFrame = root.CFrame,
		Parent = root,
	})

	-- Noclip the whole assembly while it is held so walls/props can't block it
	local parts = {}
	local ok, connected = pcall(function()
		return root:GetConnectedParts(true)
	end)
	for _, p in ipairs(ok and connected or { root }) do
		if p:IsA("BasePart") then
			parts[#parts + 1] = { part = p, cc = p.CanCollide }
			p.CanCollide = false
		end
	end

	local entry = { root = root, bp = bp, bg = bg, parts = parts }
	capturedSet[root] = entry
	return entry
end

local function refreshCaptures()
	-- 1) prune dead / anchored / stripped entries
	local alive = {}
	for _, e in ipairs(captured) do
		local r = e.root
		if r.Parent and not r.Anchored and e.bp.Parent == r and e.bg.Parent == r then
			alive[#alive + 1] = e
		else
			release(e)
		end
	end
	captured = alive

	-- 2) trim extras
	while #captured > Magnet.count do
		release(table.remove(captured))
	end

	-- 3) fill up with the nearest free assemblies (blocks, ragdolls, NPCs, vehicles, ...)
	if #captured < Magnet.count then
		local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end

		local excluded = buildExcluded()
		local seen, found = {}, {}
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not obj.Anchored then
				local root = obj.AssemblyRootPart
				if root and not root.Anchored and not seen[root] and not capturedSet[root] then
					seen[root] = true
					if not isInsideAny(root, excluded) and not isInsideAny(obj, excluded) then
						found[#found + 1] = { root = root, dist = (root.Position - hrp.Position).Magnitude }
					end
				end
			end
		end

		table.sort(found, function(a, b)
			return a.dist < b.dist
		end)

		for i = 1, math.min(Magnet.count - #captured, #found) do
			captured[#captured + 1] = capture(found[i].root)
		end
	end
end

local function magnetStep(dt)
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local now = os.clock()
	if now - lastSim > 1 then
		lastSim = now
		claimSimulation()
	end
	if (Magnet.dirty and now - lastScan > 0.25) or (#captured < Magnet.count and now - lastScan > 3) then
		Magnet.dirty = false
		lastScan = now
		refreshCaptures()
	end

	spinAngle += dt * Magnet.spinSpeed

	local n = #captured
	local center = hrp.Position
	local shape = Magnet.shapes[Magnet.shape]
	local rot = now * 0.5
	local needsPrune = false

	for i, e in ipairs(captured) do
		local r = e.root
		if r.Parent and e.bp.Parent == r and e.bg.Parent == r then
			e.bp.Position = center + formationOffset(shape, i, n, Magnet.radius, rot)
			if Magnet.spin then
				e.bg.CFrame = CFrame.Angles(0, spinAngle + i * 0.5, 0)
			else
				e.bg.CFrame = CFrame.new()
			end
		else
			needsPrune = true
		end
	end

	if needsPrune then
		Magnet.dirty = true
	end
end

local function releaseAll()
	for _, e in ipairs(captured) do
		release(e)
	end
	captured = {}
	capturedSet = {}
end

local function setMagnet(on)
	Magnet.enabled = on
	if magnetConn then
		magnetConn:Disconnect()
		magnetConn = nil
	end
	if on then
		claimSimulation()
		Magnet.dirty = true
		lastScan = 0
		magnetConn = RunService.Heartbeat:Connect(magnetStep)
	else
		releaseAll() -- BodyPosition/BodyGyro destroyed, parts fall back
	end
end

----------------------------------------------------------------------
-- PLAYER ESP
----------------------------------------------------------------------
local ESP = {
	enabled = false,
	showNames = CONFIG.ESP.ShowNames,
	fillIndex = presetIndex(CONFIG.ESP.FillColor),
	outlineIndex = presetIndex(CONFIG.ESP.OutlineColor),
	fillTransparency = CONFIG.ESP.FillTransparency,
	outlineTransparency = CONFIG.ESP.OutlineTransparency,
	objects = {},   -- [player] = { highlight, billboard, died }
	hooks = {},     -- [player] = { connections }
}

local function clearESP(plr)
	local e = ESP.objects[plr]
	if not e then
		return
	end
	ESP.objects[plr] = nil
	if e.died then e.died:Disconnect() end
	if e.highlight then e.highlight:Destroy() end
	if e.billboard then e.billboard:Destroy() end
end

local function applyESP(plr)
	clearESP(plr)
	if not ESP.enabled or plr == LocalPlayer then
		return
	end
	local char = plr.Character
	if not char then
		return
	end

	local entry = {}
	ESP.objects[plr] = entry

	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 10)
		local head = char:WaitForChild("Head", 10)
		-- bail if state changed while waiting (toggled off, respawned, left, ...)
		if ESP.objects[plr] ~= entry or plr.Character ~= char or not hum or hum.Health <= 0 then
			return
		end

		entry.highlight = new("Highlight", {
			Name = "MT_ESP",
			Adornee = char,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			FillColor = ColorPresets[ESP.fillIndex][2],
			OutlineColor = ColorPresets[ESP.outlineIndex][2],
			FillTransparency = ESP.fillTransparency,
			OutlineTransparency = ESP.outlineTransparency,
			Parent = espFolder,
		})

		if head then
			local bb = new("BillboardGui", {
				Name = "MT_Name",
				Adornee = head,
				AlwaysOnTop = true,
				Size = UDim2.fromOffset(200, 30),
				StudsOffset = Vector3.new(0, 2.5, 0),
				Enabled = ESP.showNames,
				Parent = espFolder,
			})
			new("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Text = plr.DisplayName,
				TextColor3 = Color3.new(1, 1, 1),
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0.4,
				TextSize = 14,
				Parent = bb,
			})
			entry.billboard = bb
		end

		entry.died = hum.Died:Connect(function()
			if ESP.objects[plr] == entry then
				clearESP(plr)
			end
		end)
	end)
end

local function updateESPStyle()
	for _, e in pairs(ESP.objects) do
		if e.highlight then
			e.highlight.FillColor = ColorPresets[ESP.fillIndex][2]
			e.highlight.OutlineColor = ColorPresets[ESP.outlineIndex][2]
			e.highlight.FillTransparency = ESP.fillTransparency
			e.highlight.OutlineTransparency = ESP.outlineTransparency
		end
		if e.billboard then
			e.billboard.Enabled = ESP.showNames
		end
	end
end

local function hookPlayer(plr)
	if plr == LocalPlayer or ESP.hooks[plr] then
		return
	end
	ESP.hooks[plr] = {
		plr.CharacterAdded:Connect(function()
			applyESP(plr)
		end),
		plr.CharacterRemoving:Connect(function()
			clearESP(plr)
		end),
	}
	if plr.Character then
		applyESP(plr)
	end
end

local function unhookPlayer(plr)
	clearESP(plr)
	local hooks = ESP.hooks[plr]
	if hooks then
		for _, c in ipairs(hooks) do
			c:Disconnect()
		end
		ESP.hooks[plr] = nil
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
	hookPlayer(plr)
end
track(Players.PlayerAdded:Connect(hookPlayer))
track(Players.PlayerRemoving:Connect(unhookPlayer))

local function setESP(on)
	ESP.enabled = on
	if on then
		for _, plr in ipairs(Players:GetPlayers()) do
			applyESP(plr)
		end
	else
		for plr in pairs(ESP.objects) do
			clearESP(plr)
		end
	end
end

----------------------------------------------------------------------
-- OBJECT ESP (every unanchored / movable object, visible through walls)
----------------------------------------------------------------------
local ObjESP = {
	enabled = false,
	max = CONFIG.ObjectESP.MaxObjects,
	colorIndex = presetIndex(CONFIG.ObjectESP.Color),
	fillTransparency = CONFIG.ObjectESP.FillTransparency,
	objects = {}, -- [part] = { box, sel }
	last = 0,
}
local objFolder = new("Folder", { Name = "MultiToolObjESP", Parent = gui.Parent })
local objConn

local function clearObj(part)
	local e = ObjESP.objects[part]
	if e then
		e.box:Destroy()
		e.sel:Destroy()
		ObjESP.objects[part] = nil
	end
end

local function addObj(part)
	local color = ColorPresets[ObjESP.colorIndex][2]
	ObjESP.objects[part] = {
		box = new("BoxHandleAdornment", {
			Adornee = part,
			AlwaysOnTop = true, -- visible through walls
			ZIndex = 5,
			Size = part.Size + Vector3.new(0.05, 0.05, 0.05),
			Color3 = color,
			Transparency = ObjESP.fillTransparency,
			Parent = objFolder,
		}),
		sel = new("SelectionBox", {
			Adornee = part,
			Color3 = color,
			LineThickness = 0.04,
			SurfaceTransparency = 1,
			Parent = objFolder,
		}),
	}
end

local function scanObjects()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local origin = hrp and hrp.Position or Workspace.CurrentCamera.CFrame.Position
	local excluded = buildExcluded()

	local found = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and not obj.Anchored then
			local root = obj.AssemblyRootPart
			if root and not root.Anchored and not isInsideAny(obj, excluded) then
				found[#found + 1] = { part = obj, dist = (obj.Position - origin).Magnitude }
			end
		end
	end
	table.sort(found, function(a, b)
		return a.dist < b.dist
	end)

	local keep = {}
	for i = 1, math.min(ObjESP.max, #found) do
		keep[found[i].part] = true
	end
	for part in pairs(ObjESP.objects) do
		if not keep[part] or not part.Parent or part.Anchored then
			clearObj(part)
		end
	end
	for part in pairs(keep) do
		if not ObjESP.objects[part] then
			addObj(part)
		end
	end
end

local function updateObjStyle()
	local color = ColorPresets[ObjESP.colorIndex][2]
	for _, e in pairs(ObjESP.objects) do
		e.box.Color3 = color
		e.box.Transparency = ObjESP.fillTransparency
		e.sel.Color3 = color
	end
end

local function setObjectESP(on)
	ObjESP.enabled = on
	if objConn then
		objConn:Disconnect()
		objConn = nil
	end
	if on then
		ObjESP.last = 0
		objConn = RunService.Heartbeat:Connect(function()
			local now = os.clock()
			if now - ObjESP.last >= CONFIG.ObjectESP.ScanInterval then
				ObjESP.last = now
				scanObjects()
			end
		end)
	else
		for part in pairs(ObjESP.objects) do
			clearObj(part)
		end
	end
end

----------------------------------------------------------------------
-- Cleanup / close
----------------------------------------------------------------------
local function cleanup()
	Fly.enabled = false
	stopFly()
	setMagnet(false)
	setObjectESP(false)

	ESP.enabled = false
	for plr in pairs(ESP.objects) do
		clearESP(plr)
	end
	for plr in pairs(ESP.hooks) do
		unhookPlayer(plr)
	end

	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	connections = {}

	local cam = Workspace.CurrentCamera
	local fx = cam and cam:FindFirstChild("MT_FX")
	if fx then fx:Destroy() end
	if objFolder then objFolder:Destroy() end
	if espFolder then espFolder:Destroy() end
	if gui then gui:Destroy() end
	env.__MultiToolCleanup = nil
end

env.__MultiToolCleanup = cleanup
closeBtn.MouseButton1Click:Connect(cleanup)

