local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

local function findAndJoinEmptyServer()
    local player = Players.LocalPlayer
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    
    -- Используем прокси roproxy.com, так как прямой доступ к roblox.com заблокирован
    local url = string.format(
        "https://games.roproxy.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        placeId
    )

    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if not success or not response or not response.data then
        warn("Не удалось получить список серверов")
        return false
    end

    local targetServer = nil
    for _, server in ipairs(response.data) do
        -- Ищем сервер с 0 или 1 игроком, кроме текущего
        if server.playing <= 1 and server.id ~= currentJobId then
            targetServer = server
            break
        end
    end

    if targetServer then
        print(string.format("Найден сервер: %s (игроков: %d)", targetServer.id, targetServer.playing))
        -- Телепортируемся на найденный сервер
        TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, player)
        return true
    else
        warn("Сервер с низким онлайном не найден. Попробуй ещё раз.")
        return false
    end
end

-- Пример вызова функции (можно привязать к кнопке в меню)
findAndJoinEmptyServer()
