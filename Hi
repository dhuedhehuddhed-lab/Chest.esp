		lines[i] = {
			part = new("Part", {
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(210, 225, 255),
				Transparency = 1,
				Size = Vector3.new(0.07, 0.07, 6),
				Parent = folder,
			}),
			x = math.cos(ang) * rad,
			y = math.sin(ang) * rad,
			z = math.random() * 100 - 50,
			spd = 0.8 + math.random() * 0.6,
		}
	end
	return folder, lines
end

local function updateLines(dt, center, dirUnit, speed, f)
	local up = math.abs(dirUnit.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	local frame = CFrame.lookAt(center, center + dirUnit, up)
	for _, l in ipairs(fly.lines) do
		l.z += dt * speed * 1.4 * l.spd
		if l.z > 50 then
			l.z = -50
		end
		local fade = 1 - math.abs(l.z) / 50
		l.part.Size = Vector3.new(0.07, 0.07, 3 + speed * 0.05 * l.spd)
		l.part.CFrame = frame * CFrame.new(l.x, l.y, l.z)
		l.part.Transparency = 1 - f * 0.7 * fade
	end
end

local function flyStep(dt)
	local hrp, hum, char = fly.hrp, fly.hum, fly.char
	if not hrp or not hum or not hrp:IsDescendantOf(Workspace) or hum.Health <= 0 then
		stopFly()
		return
	end

	local cam = Workspace.CurrentCamera
	local now = os.clock()
	local landing = Fly.state == "landing"

	ensureMovers(hrp)
	if not hum.PlatformStand then hum.PlatformStand = true end
	if hum.AutoRotate then hum.AutoRotate = false end
	if Fly.noclip then
		for _, p in ipairs(fly.parts) do
			if p.part.CanCollide then
				p.part.CanCollide = false
			end
		end
		fly.noclipOn = true
	elseif fly.noclipOn then
		fly.noclipOn = false
		for _, p in ipairs(fly.parts) do
			if p.part.Parent then
				p.part.CanCollide = p.cc
			end
		end
	end
	if now - (fly.lastTrack or 0) > 0.4 then
		fly.lastTrack = now
		stopTracks(hum)
	end

	-- ============================================================
	-- FIX: robust movement with two modes
	-- ============================================================
	local cf = cam.CFrame
	local look, right = cf.LookVector, cf.RightVector

	-- Always compute a valid horizontal basis (failsafe when looking straight up/down)
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = flatLook.Magnitude > 1e-4 and flatLook.Unit or Vector3.new(0, 0, -1)
	local flatRight = Vector3.new(right.X, 0, right.Z)
	flatRight = flatRight.Magnitude > 1e-4 and flatRight.Unit or Vector3.new(1, 0, 0)

	local fwdRef, sideRef
	if Fly.moveMode == "plane" then
		fwdRef, sideRef = flatLook, flatRight
	else
		fwdRef, sideRef = look, right
	end

	local dir, vert = Vector3.zero, 0
	local sprint = 1
	if not landing and not UserInputService:GetFocusedTextBox() then
		if keyDown(Enum.KeyCode.W) then dir += fwdRef end
		if keyDown(Enum.KeyCode.S) then dir -= fwdRef end
		if keyDown(Enum.KeyCode.D) then dir += sideRef end
		if keyDown(Enum.KeyCode.A) then dir -= sideRef end
		if keyDown(Enum.KeyCode.Space) or keyDown(Enum.KeyCode.E) then vert += Fly.vspeed end
		if keyDown(Enum.KeyCode.LeftControl) or keyDown(Enum.KeyCode.Q) then vert -= Fly.vspeed end
		if keyDown(Enum.KeyCode.LeftShift) then sprint = Fly.sprint end

		-- touch / gamepad fallback
		if dir.Magnitude < 1e-4 and (not UserInputService.KeyboardEnabled or UserInputService.GamepadEnabled) then
			local md = hum.MoveDirection
			if md.Magnitude > 0.05 then
				dir = fwdRef * md:Dot(flatLook) + sideRef * md:Dot(flatRight)
			end
			if hum.Jump then vert += Fly.vspeed end
		end
	end
	fly.maxSpeed = Fly.speed * sprint

	local target = (dir.Magnitude > 1 and dir.Unit or dir) * fly.maxSpeed
	target += Vector3.new(0, vert * sprint, 0)

	if fly.takeoff then
		local k = (now - fly.t0) / 0.9
		if k < 1 then
			target += Vector3.new(0, 55 * (1 - k) ^ 2, 0)
		else
			fly.takeoff = false
		end
	end

	if dir.Magnitude == 0 and vert == 0 and not landing then
		target += Vector3.new(0, math.sin(now * 2) * 1.5, 0)
	end

	local hit
	if landing then
		local ignore = { char, getFxFolder() }
		hit = groundCast(hrp.Position, 300, ignore)
		local clearance = hum.RigType == Enum.HumanoidRigType.R6 and 3 or (hum.HipHeight + hrp.Size.Y / 2)
		local h = hit and (hrp.Position.Y - hit.Position.Y - clearance) or 1e9
		target = Vector3.new(0, -math.clamp(h * 2.2, 6, 70), 0)
		if h < 1 or now - fly.landStart > 4 then
			local effects, pos = Fly.effects, hit and hit.Position
			local impact = math.abs(fly.vel.Y)
			stopFly()
			if effects and pos then
				spawnShockwave(pos, 9 + math.min(impact, 60) * 0.15, Color3.fromRGB(200, 215, 255), 0.7)
			end
			return
		end
	end

	fly.vel = fly.vel:Lerp(target, 1 - math.exp(-dt * (landing and 5 or 7)))
	fly.bv.Velocity = fly.vel
	hrp.AssemblyLinearVelocity = fly.vel

	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 1e-3 then
		fly.flat = flat.Unit
	end
	local flatLook2 = fly.flat or Vector3.new(0, 0, -1)
	local yaw = math.atan2(-flatLook2.X, -flatLook2.Z)
	local dyaw = (yaw - fly.lastYaw + math.pi) % (math.pi * 2) - math.pi
	fly.lastYaw = yaw
	local yawRate = dt > 0 and dyaw / dt or 0

	local v = fly.vel
	local speed = v.Magnitude
	local s = math.clamp(speed / (fly.maxSpeed * 0.85), 0, 1)
	local fwd = v:Dot(flatLook2)
	local strafe = v:Dot(Vector3.new(right.X, 0, right.Z))
	local gate = math.clamp(s * 1.6, 0, 1)

	local leanTarget = 0
	if speed > 3 and not landing then
		leanTarget = math.clamp(math.atan2(fwd, v.Y), math.rad(-25), math.rad(105)) * gate
	end
	local rollTarget = (math.clamp(yawRate * 0.18, -1, 1) * math.rad(40)
		- math.clamp(strafe / Fly.speed, -1, 1) * math.rad(25)) * gate

	local k = 1 - math.exp(-dt * 7)
	fly.lean += (leanTarget - fly.lean) * k
	fly.roll += (rollTarget - fly.roll) * k
	fly.poseW += (math.clamp(fly.lean / math.rad(80), 0, 1) - fly.poseW) * (1 - math.exp(-dt * 5))

	fly.bg.CFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, fly.roll) * CFrame.Angles(-fly.lean, 0, 0)

	for _, m in ipairs(fly.motors) do
		m.motor.C0 = m.c0 * CFrame.Angles(0, 0, m.sign * math.rad(165) * fly.poseW)
	end
	if fly.neck then
		fly.neck.motor.C0 = fly.neck.c0 * CFrame.Angles(fly.lean * 0.75, 0, 0)
	end

	local f = math.clamp((speed - Fly.speed * 0.35) / (Fly.speed * 0.5), 0, 1)
	local fxOn = Fly.effects

	fly.fov += ((fxOn and 20 * s or 0) - fly.fov) * k
	cam.FieldOfView = fly.baseFOV + fly.fov

	local trailsOn = fxOn and s > 0.3
	for _, t in ipairs(fly.trails) do
		t.trail.Enabled = trailsOn
	end
	fly.emitter.Rate = fxOn and f * 60 or 0

	if fxOn and f > 0.01 then
		fly.linesVisible = true
		updateLines(dt, hrp.Position, speed > 1 and v.Unit or look, speed, f)
	elseif fly.linesVisible then
		fly.linesVisible = false
		for _, l in ipairs(fly.lines) do
			l.part.Transparency = 1
		end
	end
end

local function startFly(takeoff)
	stopFly()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return
	end
	local cam = Workspace.CurrentCamera

	fly.char, fly.hrp, fly.hum = char, hrp, hum
	fly.t0 = os.clock()
	fly.takeoff = takeoff
	fly.vel = hrp.AssemblyLinearVelocity
	fly.lean, fly.roll, fly.poseW, fly.fov = 0, 0, 0, 0
	fly.baseFOV = cam.FieldOfView
	local look = cam.CFrame.LookVector
	fly.lastYaw = math.atan2(-look.X, -look.Z)

	hum.PlatformStand = true
	hum.AutoRotate = false
	fly.animate = char:FindFirstChild("Animate")
	if fly.animate then
		pcall(function()
			fly.animate.Disabled = true
		end)
	end
	stopTracks(hum)

	fly.parts = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			fly.parts[#fly.parts + 1] = { part = d, cc = d.CanCollide }
		end
	end
	local neck = char:FindFirstChild("Neck", true)
	if neck and neck:IsA("Motor6D") and neck.Parent and neck.Parent.Name == "Head" then
		fly.neck = { motor = neck, c0 = neck.C0 }
	end

	fly.motors = {}
	for _, j in ipairs(ARM_JOINTS) do
		local m = char:FindFirstChild(j[1], true)
		if m and m:IsA("Motor6D") then
			fly.motors[#fly.motors + 1] = { motor = m, c0 = m.C0, sign = j[2] }
		end
	end

	ensureMovers(hrp)
	fly.trails = setupTrails(char, hrp)
	fly.linesFolder, fly.lines = setupLines()
	fly.emitter = new("ParticleEmitter", {
		Rate = 0,
		Lifetime = NumberRange.new(0.35, 0.6),
		Speed = NumberRange.new(0, 2),
		LockedToPart = false,
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.new(1, 1, 1), Theme.Accent),
		Parent = hrp,
	})

	if takeoff and Fly.effects then
		local hit = groundCast(hrp.Position, 12, { char, getFxFolder() })
		if hit then
			spawnShockwave(hit.Position, 14, Color3.fromRGB(200, 215, 255), 0.8)
		end
	end

	Fly.state = "active"
	fly.conn = RunService.RenderStepped:Connect(flyStep)
end

local function setFly(on)
	if on then
		Fly.enabled = true
		if Fly.state == "landing" then
			Fly.state = "active"
		elseif Fly.state == "off" then
			startFly(true)
		end
	else
		Fly.enabled = false
		if Fly.state == "active" then
			Fly.state = "landing"
			fly.landStart = os.clock()
		else
			stopFly()
		end
	end
end

track(LocalPlayer.CharacterAdded:Connect(function(char)
	if Fly.enabled then
		char:WaitForChild("HumanoidRootPart", 10)
		char:WaitForChild("Humanoid", 10)
		if Fly.enabled then
			startFly(false)
		end
	end
end))

----------------------------------------------------------------------
-- MAGNET + FORMATION
----------------------------------------------------------------------
local Magnet = {
	enabled = false,
	count = CONFIG.Magnet.PartCount,
	radius = CONFIG.Magnet.Radius,
	shapes = { "Circle", "Sphere", "Cube", "Helix" },
	shape = 1,
	spin = false,
	spinSpeed = CONFIG.Magnet.SpinSpeed,
	dirty = false,
}
local captured = {}
local capturedSet = {}
local magnetConn
local spinAngle, lastScan, lastSim = 0, 0, 0

local function claimSimulation()
	pcall(function()
		LocalPlayer.MaximumSimulationRadius = math.huge
	end)
	pcall(function()
		sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
	end)
end

local function norm(k, side)
	if side > 1 then
		return (k / (side - 1)) * 2 - 1
	end
	return 0
end

local function formationOffset(shape, i, n, r, rot)
	local v
	if shape == "Circle" then
		local a = (i / n) * math.pi * 2
		v = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)

	elseif shape == "Sphere" then
		local y = 1 - 2 * (i - 0.5) / n
		local rad = math.sqrt(math.max(0, 1 - y * y))
		local theta = i * 2.399963229728653
		v = Vector3.new(math.cos(theta) * rad, y, math.sin(theta) * rad) * r

	elseif shape == "Cube" then
		local idx = i - 1
		local face = idx % 6
		local j = math.floor(idx / 6)
		local side = math.max(1, math.ceil(math.sqrt(math.ceil(n / 6))))
		local u = norm(j % side, side)
		local w = norm(math.floor(j / side), side)
		if face == 0 then v = Vector3.new(1, u, w)
		elseif face == 1 then v = Vector3.new(-1, u, w)
		elseif face == 2 then v = Vector3.new(u, 1, w)
		elseif face == 3 then v = Vector3.new(u, -1, w)
		elseif face == 4 then v = Vector3.new(u, w, 1)
		else v = Vector3.new(u, w, -1) end
		v = v * r

	else
		local f = n > 1 and (i - 1) / (n - 1) or 0.5
		local a = f * math.pi * 2 * 3
		v = Vector3.new(math.cos(a) * r, (f * 2 - 1) * r, math.sin(a) * r)
	end

	return CFrame.Angles(0, rot, 0) * v
end

local function release(entry)
	capturedSet[entry.root] = nil
	if entry.bp then entry.bp:Destroy() end
	if entry.bg then entry.bg:Destroy() end
	for _, p in ipairs(entry.parts) do
		if p.part.Parent then
			p.part.CanCollide = p.cc
		end
	end
end

local function capture(root)
	local mass = math.max(root.AssemblyMass, 0.05)

	local bp = new("BodyPosition", {
		Name = "MT_BP",
		MaxForce = Vector3.one * mass * 2000,
		P = mass * 400,
		D = mass * 45,
		Position = root.Position,
		Parent = root,
	})
	local bg = new("BodyGyro", {
		Name = "MT_BG",
		MaxTorque = Vector3.one * math.max(4e5, mass * 4e4),
		P = 3e3,
		D = 3e2,
		CFrame = root.CFrame,
		Parent = root,
	})

	local parts = {}
	local ok, connected = pcall(function()
		return root:GetConnectedParts(true)
	end)
	for _, p in ipairs(ok and connected or { root }) do
		if p:IsA("BasePart") then
			parts[#parts + 1] = { part = p, cc = p.CanCollide }
			p.CanCollide = false
		end
	end

	local entry = { root = root, bp = bp, bg = bg, parts = parts, maxForce = bp.MaxForce, far = false }
	capturedSet[root] = entry
	return entry
end

local function refreshCaptures()
	local alive = {}
	for _, e in ipairs(captured) do
		local r = e.root
		if r.Parent and not r.Anchored and e.bp.Parent == r and e.bg.Parent == r then
			alive[#alive + 1] = e
		else
			release(e)
		end
	end
	captured = alive

	while #captured > Magnet.count do
		release(table.remove(captured))
	end

	if #captured < Magnet.count then
		local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end

		local excluded = buildExcluded()
		local seen, found = {}, {}
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not obj.Anchored then
				local root = obj.AssemblyRootPart
				if root and not root.Anchored and not seen[root] and not capturedSet[root] then
					seen[root] = true
					if not isInsideAny(root, excluded) and not isInsideAny(obj, excluded) then
						found[#found + 1] = { root = root, dist = (root.Position - hrp.Position).Magnitude }
					end
				end
			end
		end

		table.sort(found, function(a, b)
			return a.dist < b.dist
		end)

		for i = 1, math.min(Magnet.count - #captured, #found) do
			captured[#captured + 1] = capture(found[i].root)
		end
	end
end

local function magnetStep(dt)
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local now = os.clock()
	if now - lastSim > 1 then
		lastSim = now
		claimSimulation()
	end

	-- FIX: aggressive rescans so newly spawned / newly streamed-in parts get pulled in
	local wantScan = Magnet.dirty or CONFIG.Magnet.Unlimited or #captured < Magnet.count
	if wantScan and now - lastScan > (Magnet.dirty and 0.25 or CONFIG.Magnet.ScanInterval) then
		Magnet.dirty = false
		lastScan = now
		refreshCaptures()
	end

	spinAngle += dt * Magnet.spinSpeed

	local n = #captured
	local center = hrp.Position
	local shape = Magnet.shapes[Magnet.shape]
	local rot = now * 0.5
	local needsPrune = false

	for i, e in ipairs(captured) do
		local r = e.root
		if r.Parent and e.bp.Parent == r and e.bg.Parent == r then
			local goal = center + formationOffset(shape, i, n, Magnet.radius, rot)
			local delta = goal - r.Position
			local dist = delta.Magnitude
			local farLimit = CONFIG.Magnet.FarDistance
			if dist > farLimit or (e.far and dist > farLimit * 0.75) then
				-- No range limit: pull straight at max speed from any distance
				e.far = true
				e.bp.MaxForce = Vector3.zero
				r.AssemblyLinearVelocity = delta.Unit * math.clamp(dist * 3, 150, CONFIG.Magnet.MaxPullSpeed)
			elseif e.far then
				e.far = false
				e.bp.MaxForce = e.maxForce
			end
			e.bp.Position = goal
			if Magnet.spin then
				e.bg.CFrame = CFrame.Angles(0, spinAngle + i * 0.5, 0)
			else
				e.bg.CFrame = CFrame.new()
			end
		else
			needsPrune = true
		end
	end

	if needsPrune then
		Magnet.dirty = true
	end
end

local function releaseAll()
	for _, e in ipairs(captured) do
		release(e)
	end
	captured = {}
	capturedSet = {}
end

local function setMagnet(on)
	Magnet.enabled = on
	if magnetConn then
		magnetConn:Disconnect()
		magnetConn = nil
	end
	if on then
		claimSimulation()
		Magnet.dirty = true
		lastScan = 0
		magnetConn = RunService.Heartbeat:Connect(magnetStep)
	else
		releaseAll()
	end
end

----------------------------------------------------------------------
-- PLAYER ESP
----------------------------------------------------------------------
local ESP = {
	enabled = false,
	showNames = CONFIG.ESP.ShowNames,
	fillIndex = presetIndex(CONFIG.ESP.FillColor),
	outlineIndex = presetIndex(CONFIG.ESP.OutlineColor),
	fillTransparency = CONFIG.ESP.FillTransparency,
	outlineTransparency = CONFIG.ESP.OutlineTransparency,
	objects = {},
	hooks = {},
}

local function clearESP(plr)
	local e = ESP.objects[plr]
	if not e then
		return
	end
	ESP.objects[plr] = nil
	if e.died then e.died:Disconnect() end
	if e.highlight then e.highlight:Destroy() end
	if e.billboard then e.billboard:Destroy() end
end

local function applyESP(plr)
	clearESP(plr)
	if not ESP.enabled or plr == LocalPlayer then
		return
	end
	local char = plr.Character
	if not char then
		return
	end

	local entry = {}
	ESP.objects[plr] = entry

	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 10)
		local head = char:WaitForChild("Head", 10)
		if ESP.objects[plr] ~= entry or plr.Character ~= char or not hum or hum.Health <= 0 then
			return
		end

		entry.highlight = new("Highlight", {
			Name = "MT_ESP",
			Adornee = char,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			FillColor = ColorPresets[ESP.fillIndex][2],
			OutlineColor = ColorPresets[ESP.outlineIndex][2],
			FillTransparency = ESP.fillTransparency,
			OutlineTransparency = ESP.outlineTransparency,
			Parent = espFolder,
		})

		if head then
			local bb = new("BillboardGui", {
				Name = "MT_Name",
				Adornee = head,
				AlwaysOnTop = true,
				Size = UDim2.fromOffset(200, 30),
				StudsOffset = Vector3.new(0, 2.5, 0),
				Enabled = ESP.showNames,
				Parent = espFolder,
			})
			new("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Text = plr.DisplayName,
				TextColor3 = Color3.new(1, 1, 1),
				TextStrokeColor3 = Color3.new(0, 0, 0),
				TextStrokeTransparency = 0.4,
				TextSize = 14,
				Parent = bb,
			})
			entry.billboard = bb
		end

		entry.died = hum.Died:Connect(function()
			if ESP.objects[plr] == entry then
				clearESP(plr)
			end
		end)
	end)
end

local function updateESPStyle()
	for _, e in pairs(ESP.objects) do
		if e.highlight then
			e.highlight.FillColor = ColorPresets[ESP.fillIndex][2]
			e.highlight.OutlineColor = ColorPresets[ESP.outlineIndex][2]
			e.highlight.FillTransparency = ESP.fillTransparency
			e.highlight.OutlineTransparency = ESP.outlineTransparency
		end
		if e.billboard then
			e.billboard.Enabled = ESP.showNames
		end
	end
end

local function hookPlayer(plr)
	if plr == LocalPlayer or ESP.hooks[plr] then
		return
	end
	ESP.hooks[plr] = {
		plr.CharacterAdded:Connect(function()
			applyESP(plr)
		end),
		plr.CharacterRemoving:Connect(function()
			clearESP(plr)
		end),
	}
	if plr.Character then
		applyESP(plr)
	end
end

local function unhookPlayer(plr)
	clearESP(plr)
	local hooks = ESP.hooks[plr]
	if hooks then
		for _, c in ipairs(hooks) do
			c:Disconnect()
		end
		ESP.hooks[plr] = nil
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
	hookPlayer(plr)
end
track(Players.PlayerAdded:Connect(hookPlayer))
track(Players.PlayerRemoving:Connect(unhookPlayer))

local function setESP(on)
	ESP.enabled = on
	if on then
		for _, plr in ipairs(Players:GetPlayers()) do
			applyESP(plr)
		end
	else
		for plr in pairs(ESP.objects) do
			clearESP(plr)
		end
	end
end

