local function tweenWindowSize(toSize, duration, onDone)
	local from = root.Size
	local t0 = os.clock()
	Win.tweenId = (Win.tweenId or 0) + 1
	local id = Win.tweenId
	task.spawn(function()
		while id == Win.tweenId do
			local a = math.min((os.clock() - t0) / duration, 1)
			local e = 1 - (1 - a) ^ 3
			root.Size = UDim2.fromOffset(
				from.X.Offset + (toSize.X.Offset - from.X.Offset) * e,
				from.Y.Offset + (toSize.Y.Offset - from.Y.Offset) * e
			)
			if a >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		if id == Win.tweenId and onDone then
			onDone()
		end
	end)
end

local function setCollapsed(c, instant)
	Win.collapsed = c
	collapseBtn.Text = c and "+" or "-"
	if c then
		content.Visible = false
		if instant then
			Win.tweenId = (Win.tweenId or 0) + 1
			root.Size = UDim2.fromOffset(WIN_W, BAR_H)
		else
			tweenWindowSize(UDim2.fromOffset(WIN_W, BAR_H), 0.18)
		end
	else
		if instant then
			Win.tweenId = (Win.tweenId or 0) + 1
			root.Size = UDim2.fromOffset(WIN_W, WIN_H)
			content.Visible = true
		else
			tweenWindowSize(UDim2.fromOffset(WIN_W, WIN_H), 0.18, function()
				content.Visible = true
			end)
		end
	end
	saveSoon()
end

