		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = btn,
	})
	corner(swatch, 4)
	new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.5, Parent = swatch })
	return swatch
end

