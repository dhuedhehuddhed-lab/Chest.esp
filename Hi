local objFolder = new("Folder", { Name = "MultiToolObjESP", Parent = gui.Parent })
local objConn

local function clearObj(part)
	local e = ObjESP.objects[part]
	if e then
		e.box:Destroy()
		e.sel:Destroy()
		ObjESP.objects[part] = nil
	end
end

local function addObj(part)
	local color = ColorPresets[ObjESP.colorIndex][2]
	ObjESP.objects[part] = {
		box = new("BoxHandleAdornment", {
			Adornee = part,
			AlwaysOnTop = true,
			ZIndex = 5,
			Size = part.Size + Vector3.new(0.05, 0.05, 0.05),
			Color3 = color,
			Transparency = ObjESP.fillTransparency,
			Parent = objFolder,
		}),
		sel = new("SelectionBox", {
			Adornee = part,
			Color3 = color,
			LineThickness = 0.04,
			SurfaceTransparency = 1,
			Parent = objFolder,
		}),
	}
end

local function scanObjects()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local origin = hrp and hrp.Position or Workspace.CurrentCamera.CFrame.Position
	local excluded = buildExcluded()

	local found = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and not obj.Anchored then
			local root = obj.AssemblyRootPart
			if root and not root.Anchored and not isInsideAny(obj, excluded) then
				found[#found + 1] = { part = obj, dist = (obj.Position - origin).Magnitude }
			end
		end
	end
	table.sort(found, function(a, b)
		return a.dist < b.dist
	end)

	local keep = {}
	for i = 1, math.min(ObjESP.max, #found) do
		keep[found[i].part] = true
	end
	for part in pairs(ObjESP.objects) do
		if not keep[part] or not part.Parent or part.Anchored then
			clearObj(part)
		end
	end
	for part in pairs(keep) do
		if not ObjESP.objects[part] then
			addObj(part)
		end
	end
end

local function updateObjStyle()
	local color = ColorPresets[ObjESP.colorIndex][2]
	for _, e in pairs(ObjESP.objects) do
		e.box.Color3 = color
		e.box.Transparency = ObjESP.fillTransparency
		e.sel.Color3 = color
	end
end

local function setObjectESP(on)
	ObjESP.enabled = on
	if objConn then
		objConn:Disconnect()
		objConn = nil
	end
	if on then
		ObjESP.last = 0
		objConn = RunService.Heartbeat:Connect(function()
			local now = os.clock()
			if now - ObjESP.last >= CONFIG.ObjectESP.ScanInterval then
				ObjESP.last = now
				scanObjects()
			end
		end)
	else
		for part in pairs(ObjESP.objects) do
			clearObj(part)
		end
	end
end

----------------------------------------------------------------------
-- Settings persistence
----------------------------------------------------------------------
local Settings = {
	hotkeys = {},
	quickVisible = {},
	quickPos = {},
	quickEnabled = CONFIG.Quick.Enabled,
	quickLocked = CONFIG.Quick.Locked,
	launcherPos = nil,
	window = nil,
	flyMoveMode = CONFIG.Fly.MoveMode, -- NEW: persisted
	magnetUnlimited = CONFIG.Magnet.Unlimited, -- NEW
}

local function fileApi()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function udimToTable(u)
	return { u.X.Scale, u.X.Offset, u.Y.Scale, u.Y.Offset }
end

local function validPos(t)
	return type(t) == "table" and type(t[1]) == "number" and type(t[2]) == "number"
		and type(t[3]) == "number" and type(t[4]) == "number"
end

local function tableToUDim(t)
	return UDim2.new(t[1], t[2], t[3], t[4])
end

local function loadSettings()
	if not fileApi() then
		return
	end
	local ok, data = pcall(function()
		if isfile(CONFIG.SaveFile) then
			return HttpService:JSONDecode(readfile(CONFIG.SaveFile))
		end
	end)
	if not ok or type(data) ~= "table" then
		return
	end

	if type(data.hotkeys) == "table" then
		for id, name in pairs(data.hotkeys) do
			if name == "" then
				Settings.hotkeys[id] = false
			else
				local okk, kc = pcall(function()
					return Enum.KeyCode[name]
				end)
				if okk and kc then
					Settings.hotkeys[id] = kc
				end
			end
		end
	end
	if type(data.quickVisible) == "table" then
		for id, v in pairs(data.quickVisible) do
			Settings.quickVisible[id] = v and true or false
		end
	end
	if type(data.quickPos) == "table" then
		for id, t in pairs(data.quickPos) do
			if validPos(t) then
				Settings.quickPos[id] = t
			end
		end
	end
	if type(data.quickEnabled) == "boolean" then Settings.quickEnabled = data.quickEnabled end
	if type(data.quickLocked) == "boolean" then Settings.quickLocked = data.quickLocked end
	if validPos(data.launcherPos) then Settings.launcherPos = data.launcherPos end
	if type(data.window) == "table" and validPos(data.window.pos) then
		Settings.window = data.window
	end
	if data.flyMoveMode == "camera" or data.flyMoveMode == "plane" then
		Settings.flyMoveMode = data.flyMoveMode
	end
	if type(data.magnetUnlimited) == "boolean" then
		Settings.magnetUnlimited = data.magnetUnlimited
	end
end

loadSettings()
for _, id in ipairs(CONFIG.Quick.Defaults) do
	if Settings.quickVisible[id] == nil then
		Settings.quickVisible[id] = true
	end
end

-- Apply loaded settings to runtime
Fly.moveMode = Settings.flyMoveMode
CONFIG.Magnet.Unlimited = Settings.magnetUnlimited

local function saveSettings()
	if not fileApi() then
		return
	end
	local hk = {}
	for id, v in pairs(Settings.hotkeys) do
		hk[id] = v and v.Name or ""
	end
	local data = {
		hotkeys = hk,
		quickVisible = Settings.quickVisible,
		quickPos = Settings.quickPos,
		quickEnabled = Settings.quickEnabled,
		quickLocked = Settings.quickLocked,
		launcherPos = Settings.launcherPos,
		window = { pos = udimToTable(root.Position), collapsed = Win.collapsed, pinned = Win.pinned },
		flyMoveMode = Fly.moveMode,
		magnetUnlimited = CONFIG.Magnet.Unlimited,
	}
	pcall(function()
		writefile(CONFIG.SaveFile, HttpService:JSONEncode(data))
	end)
end

local saveToken = 0
local function saveSoon()
	saveToken += 1
	local mine = saveToken
	task.delay(0.6, function()
		if mine == saveToken then
			saveSettings()
		end
	end)
end
Win.onMoved = saveSoon

----------------------------------------------------------------------
-- Cleanup
----------------------------------------------------------------------
local function cleanup()
	pcall(saveSettings)

	Fly.enabled = false
	stopFly()
	setMagnet(false)
	setObjectESP(false)

	ESP.enabled = false
	for plr in pairs(ESP.objects) do
		clearESP(plr)
	end
	for plr in pairs(ESP.hooks) do
		unhookPlayer(plr)
	end

	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	connections = {}

	local cam = Workspace.CurrentCamera
	local fx = cam and cam:FindFirstChild("MT_FX")
	if fx then fx:Destroy() end
	if objFolder then objFolder:Destroy() end
	if espFolder then espFolder:Destroy() end
	if gui then gui:Destroy() end
	env.__MultiToolCleanup = nil
end

env.__MultiToolCleanup = cleanup

----------------------------------------------------------------------
-- Drag helper
----------------------------------------------------------------------
local function makeDraggable(obj, onClick, canDrag, onMoved)
	local pressed, moved, startMouse, startPos = false, false, nil, nil

	obj.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		pressed, moved = true, false
		startMouse, startPos = input.Position, obj.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End and pressed then
				pressed = false
				if moved then
					onMoved()
				elseif onClick then
					onClick()
				end
			end
		end)
	end)

	track(UserInputService.InputChanged:Connect(function(input)
		if pressed and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startMouse
			if not moved and d.Magnitude > 5 and canDrag() then
				moved = true
			end
			if moved then
				obj.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + d.X,
					startPos.Y.Scale, startPos.Y.Offset + d.Y
				)
			end
		end
	end))
end

