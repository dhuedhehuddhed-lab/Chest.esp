-- Action registry
----------------------------------------------------------------------
local Actions, ActionOrder = {}, {}

local function registerAction(id, def)
	def.id = id
	def.visuals = {}
	Actions[id] = def
	ActionOrder[#ActionOrder + 1] = id
end

registerAction("fly", {
	label = "Fly", short = "Fly", kind = "toggle",
	get = function() return Fly.enabled end,
	set = setFly,
})
registerAction("magnet", {
	label = "Magnet", short = "Magnet", kind = "toggle",
	get = function() return Magnet.enabled end,
	set = setMagnet,
})
registerAction("spin", {
	label = "Spin", short = "Spin", kind = "toggle",
	get = function() return Magnet.spin end,
	set = function(on) Magnet.spin = on end,
})
registerAction("playerEsp", {
	label = "Player ESP", short = "Players", kind = "toggle",
	get = function() return ESP.enabled end,
	set = setESP,
})
registerAction("objectEsp", {
	label = "Object ESP", short = "Objects", kind = "toggle",
	get = function() return ObjESP.enabled end,
	set = setObjectESP,
})
registerAction("cycleFormation", { label = "Cycle Formation", kind = "trigger", run = cycleFormation })
registerAction("toggleMenu", { label = "Show / Hide Menu", kind = "trigger", run = toggleMenu })
registerAction("toggleQuick", { label = "Show / Hide Quick Buttons", kind = "trigger", run = toggleQuickButtons })

local function syncAction(id)
	local a = Actions[id]
	if a.kind ~= "toggle" then
		return
	end
	local on = a.get() and true or false
	for _, fn in ipairs(a.visuals) do
		fn(on)
	end
end

local function setAction(id, on)
	Actions[id].set(on)
	syncAction(id)
end

local function toggleAction(id)
	local a = Actions[id]
	if a.kind == "toggle" then
		setAction(id, not a.get())
	else
		a.run()
	end
end

----------------------------------------------------------------------
-- Hotkeys
----------------------------------------------------------------------
local hotkeys = {}
for id, name in pairs(CONFIG.Hotkeys) do
	local okk, kc = pcall(function()
		return Enum.KeyCode[name]
	end)
	if okk and kc then
		hotkeys[id] = kc
	end
end
for id, v in pairs(Settings.hotkeys) do
	hotkeys[id] = v or nil
end

local RESERVED = {
	[Enum.KeyCode.W] = true, [Enum.KeyCode.A] = true, [Enum.KeyCode.S] = true, [Enum.KeyCode.D] = true,
	[Enum.KeyCode.E] = true, [Enum.KeyCode.Q] = true, [Enum.KeyCode.Space] = true,
	[Enum.KeyCode.LeftControl] = true, [Enum.KeyCode.LeftShift] = true,
}

local listening
local bindRows = {}

local function keyText(id)
	local k = hotkeys[id]
	return k and k.Name or "None"
end

local function refreshBind(id)
	local r = bindRows[id]
	if r then
		local waiting = listening == id
		r.keyBtn.Text = waiting and "Press key..." or keyText(id)
		r.keyBtn.BackgroundColor3 = waiting and Theme.Accent or Theme.Track
	end
	local q = quickButtons[id]
	if q then
		q.keyLbl.Text = hotkeys[id] and ("[" .. keyText(id) .. "]") or ""
	end
end

local function refreshAllBinds()
	for id in pairs(Actions) do
		refreshBind(id)
	end
end

track(UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local kc = input.KeyCode

	if listening then
		local id = listening
		listening = nil
		if kc == Enum.KeyCode.Escape then
			refreshAllBinds()
		elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
			hotkeys[id] = nil
			Settings.hotkeys[id] = false
			refreshAllBinds()
			saveSoon()
		elseif RESERVED[kc] then
			refreshAllBinds()
			local r = bindRows[id]
			if r then
				r.keyBtn.Text = "Reserved"
				task.delay(1, function()
					refreshBind(id)
				end)
			end
		elseif kc ~= Enum.KeyCode.Unknown then
			for other, k in pairs(hotkeys) do
				if k == kc and other ~= id then
					hotkeys[other] = nil
					Settings.hotkeys[other] = false
				end
			end
			hotkeys[id] = kc
			Settings.hotkeys[id] = kc
			refreshAllBinds()
			saveSoon()
		end
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end
	for _, id in ipairs(ActionOrder) do
		if hotkeys[id] == kc then
			toggleAction(id)
			break
		end
	end
end))

